# Copy to .env and fill in to change the defaults. Never commit .env.

# Port on the host where the website is reachable, over IPv4 (default 9393).
PORT=

# Published image to run: latest (newest release), a release such as 0.1.0 to stay on it,
# or main to follow every change on the main branch (default latest).
IMAGE_TAG=


# Comma-separated disks to show, such as /,/mnt/usb (default /). Mount every path
# except / read-only in compose.yaml first.
DISK_PATHS=

# Days of usage history to keep, from 1 to 3650 (default 30). Older values are
# deleted automatically. Takes effect when the container is restarted.
RETENTION_DAYS=

# How many disks, temperature sensors, network cards and GPUs each the history
# keeps per device, from 1 to 10000 (default 64); the dashboard shows them all.
HISTORY_MAX_ENTRIES=

# Minutes of history kept in memory before they are written to the database
# together, from 1 to 60 (default 10). A longer time writes less to an SD card;
# a power cut loses what waits.
HISTORY_FLUSH_MINUTES=

# How the page names this device (default "Host Hub").
DEVICE_NAME=

# Hub mode: other devices on the local network whose usage this one collects
# and shows, as comma-separated name=address:port entries, such as
# Living room Pi=192.168.1.20:9393,Office PC=192.168.1.30:9393 (default none).
HUB_DEVICES=

# Routers to show as devices of their own, as name=protocol:address entries:
# Router=upnp:192.168.1.1 reads the internet traffic of most routers (ASUS,
# Technicolor, FRITZ!Box, provider boxes) without a login, with UPnP switched
# on in the router; Router=asus:admin@192.168.1.1 reads an ASUS router's CPU,
# memory, ports, Wi-Fi, clients and temperatures with its login;
# Box=fritzbox:user@192.168.178.1 a FRITZ!Box's line and clients;
# Switch=snmp:192.168.1.2 or Core=snmpv3:user@192.168.1.3 every port, CPU and
# memory over SNMP. Passwords, and an SNMP community other than public, go in
# router-secrets/router-passwords. Run sudo ./setup-router.sh
# to set it up. Nothing read from the router leaves this machine (default none).
HUB_ROUTERS=

# Things that run no den-watcher, such as a printer, NAS or IP camera, shown as
# devices the hub only checks for whether they answer, with how long the answer
# took: name=address:port connects to a TCP port, name=address pings, such as
# Printer=192.168.1.50:631,NAS=192.168.1.10. Only addresses on the local
# network are checked (default none).
HUB_CHECKS=

# true serves only the usage data for a hub on another device, without the
# website and history, like the Windows installer does by default (default false).
DATA_ONLY=

# With DATA_ONLY, hours of usage this device keeps for a hub that cannot reach
# it, from 1 to 168; the hub fetches them once it can, and they are deleted
# then (default 24).
BUFFER_HOURS=

# true deletes the password for adding and removing devices on the page, if it
# is forgotten; the next device added chooses a new one. Unset it again after
# one restart (default false).
RESET_PASSWORD=

# false stops the daily question to GitHub whether a newer release exists,
# which the page then names (default true). Nothing is ever installed by it.
UPDATE_CHECK=

# The page answers only when opened by this machine's IP address, by localhost,
# by its hostname or by a .local name. Other names the page should be reachable
# by, such as one from the router's DNS, go here, comma-separated, such as
# pi.fritz.box,usage.home.lan (default none).
ALLOWED_HOSTS=

# true serves GET /metrics: the usage of this device and of every device it
# collects from in the Prometheus text format, for Prometheus and Grafana on the
# local network. Not with DATA_ONLY (default false).
PROMETHEUS=

# Port on the host for the status page, such as 9443: a minimal page over HTTPS
# that only tells whether each device is online and how many alerts it has, for
# outside the local network. Set its password on the page under Devices, then
# forward the port on the router. Not with DATA_ONLY (default none: no status page).
STATUS_PORT=

# Add-ons to run next to den-watcher, comma-separated: power reads the power
# Intel and AMD CPUs draw, pressure how often tasks wait for the CPU, memory or
# disks, kernel what the kernel is busy with, wifi the quality and signal of
# the Wi-Fi link, memory memory details such as dirty and slab memory and page
# faults, ports the ports the machine listens on, containers the CPU and
# memory of each container, processes the processes using the most CPU and
# memory, bluetooth the Bluetooth devices connected (default none). cub runs
# the lightweight ones, pressure, kernel, wifi and memory: the Cub edition.
# The Grizzly edition is cub with the others you want, such as
# cub,power,processes. A group runs all of its add-ons: details (kernel,
# memory, pressure), hardware (power), network (wifi, ports), bluetooth and
# programs (processes, containers), such as cub,programs.
COMPOSE_PROFILES=

# For the wifi add-on: 0 reads only the connected Wi-Fi interfaces, not the
# networks nearby (default 1).
WIFI_NEARBY=

# For the bluetooth add-on: 0 shows each connected device by its kind, such as
# Headphones, instead of its name, which often carries its owner's name
# (default 1).
BLUETOOTH_NAMES=

# Docker's data folder on this machine, from which the containers add-on reads
# the containers' names; set it if Docker keeps its data elsewhere, such as
# /home/pi/.local/share/docker for rootless Docker (with compose only; the
# archive's service cannot read /home). docker info shows it as Docker Root
# Dir (default /var/lib/docker).
DOCKER_DIR=
