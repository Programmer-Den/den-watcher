# Runs den-watcher on a Linux machine without Docker. linux/install.sh puts
# it in /etc/systemd/system; settings go in /etc/den-watcher.env.
[Unit]
Description=Den-Watcher: shows the usage of this machine on the local network
Documentation=https://github.com/Programmer-Den/den-watcher
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/den-watcher
EnvironmentFile=-/etc/den-watcher.env
# The history database, kept in /var/lib/den-watcher across updates.
Environment=DATABASE_PATH=/var/lib/den-watcher/usage-control.db
StateDirectory=den-watcher
# Where installed add-ons, such as the power add-on, write what they read.
Environment=ADDONS_DIR=/run/den-watcher-addons
Restart=on-failure
RestartSec=5

# The site only reads hardware data, so it runs as a throwaway user without
# privileges and can write nowhere but its own state folder.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Not ProtectClock=yes: it also limits the devices to the clock's, which
# keeps nvidia-smi and vcgencmd from opening theirs. Without capabilities the
# clock cannot be set anyway; this also blocks the calls that set it.
SystemCallFilter=~@clock
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Not MemoryDenyWriteExecute=yes: nvidia-smi, which reads NVIDIA GPUs, may
# need memory that is written and run, as in the gpu add-on.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
