# Settings for den-watcher; install.sh copies this to /etc/den-watcher.env
# once and never overwrites it. Restart after a change:
#   sudo systemctl restart den-watcher

# Address to listen on (default :9393, every network card).
LISTEN_ADDR=

# Comma-separated disks to show, such as /,/mnt/usb (default /).
DISK_PATHS=

# Days of usage history to keep, from 1 to 3650 (default 30).
RETENTION_DAYS=

# How many disks, sensors, network cards and GPUs each the history keeps per
# device, from 1 to 10000 (default 64).
HISTORY_MAX_ENTRIES=

# Minutes of history kept in memory before they are written to the database
# together, from 1 to 60 (default 10). A longer time writes less to an SD card;
# a power cut loses what waits.
HISTORY_FLUSH_MINUTES=

# How the page names this device (default "Host Hub").
DEVICE_NAME=

# Hub mode: other devices to collect from, as name=address:port entries, such as
# Office PC=192.168.1.30:9393 (default none). Devices can also be added on the page.
HUB_DEVICES=

# Routers to read, shown as devices of their own, as name=protocol:address
# entries: Router=upnp:192.168.1.1 reads the internet traffic of most routers
# (ASUS, Technicolor, FRITZ!Box, provider boxes) without a login, with UPnP
# switched on in the router; Router=asus:admin@192.168.1.1 reads an ASUS
# router's CPU, memory, ports, Wi-Fi, clients and temperatures with its login;
# Box=fritzbox:user@192.168.178.1 a FRITZ!Box's line and clients;
# Switch=snmp:192.168.1.2 or Core=snmpv3:user@192.168.1.3 every port, CPU and
# memory over SNMP. install.sh asks for the router and stores its password encrypted with
# systemd-creds; nothing read from the router leaves this machine (default none).
HUB_ROUTERS=

# Things that run no den-watcher, such as a printer, NAS or IP camera, shown as
# devices the hub only checks for whether they answer, with how long the answer
# took: name=address:port connects to a TCP port, name=address pings, such as
# Printer=192.168.1.50:631,NAS=192.168.1.10. Only addresses on the local
# network are checked (default none).
HUB_CHECKS=

# true serves only the usage data for a hub, without website and history.
DATA_ONLY=

# With DATA_ONLY, hours of usage kept for a hub that cannot reach this device,
# from 1 to 168; deleted once the hub has them (default 24).
BUFFER_HOURS=

# true deletes the password for changing devices, if it is forgotten (default false).
RESET_PASSWORD=

# false stops the daily check for a newer release (default true).
UPDATE_CHECK=

# Other names the page may be opened by, besides the IP address, localhost, the
# hostname and .local names; comma-separated, such as pi.fritz.box (default none).
ALLOWED_HOSTS=

# true serves GET /metrics for Prometheus; not with DATA_ONLY (default false).
PROMETHEUS=

# Address of the status page, such as :9443: a minimal page over HTTPS that only
# tells whether each device is online and how many alerts it has, for outside the
# local network. Set its password on the page under Devices, then forward the port
# on the router. Not with DATA_ONLY (default none: no status page).
STATUS_ADDR=

# For the containers add-on: Docker's data folder, from which it reads the
# containers' names, if Docker keeps its data elsewhere; docker info shows it as
# Docker Root Dir. Folders below /home cannot be read (default /var/lib/docker).
# The inodes add-on leaves out the containers' layers mounted below it.
DOCKER_DIR=

# For the Wi-Fi add-on: 0 reads only the connected Wi-Fi interfaces, not the
# networks nearby (default 1). Restart it after a change:
#   sudo systemctl restart den-watcher-wifi
WIFI_NEARBY=

# For the Bluetooth add-on: 0 shows each connected device by its kind, such as
# Headphones, instead of its name, which often carries its owner's name
# (default 1). Restart it after a change:
#   sudo systemctl restart den-watcher-bluetooth
BLUETOOTH_NAMES=
