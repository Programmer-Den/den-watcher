# The containers add-on of den-watcher: reads the CPU and memory each
# running container uses and writes it to /run/den-watcher-addons, which
# den-watcher shows. install.sh puts it in /etc/systemd/system when the
# add-on is picked.
[Unit]
Description=Den-Watcher containers add-on: reads the CPU and memory of each running Docker or Podman container from the kernel's cgroups (v2), without the Docker socket; runs as root without capabilities
Documentation=https://github.com/Programmer-Den/den-watcher
PartOf=den-watcher.service
After=den-watcher.service

[Service]
ExecStart=/usr/local/bin/den-watcher-containers
# DOCKER_DIR, where Docker keeps its data elsewhere, is set with the other
# settings in /etc/den-watcher.env.
EnvironmentFile=-/etc/den-watcher.env
# It writes to /run/den-watcher-addons, the add-ons' default, like the
# other add-ons, even where the settings file names another ADDONS_DIR.
UnsetEnvironment=ADDONS_DIR
# The add-on folder den-watcher reads; others may read it, only root writes.
RuntimeDirectory=den-watcher-addons
RuntimeDirectoryMode=0755
# Shared with the other add-ons, so it stays when one of them stops.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5

# Runs as root because only root may read the names of Docker's containers
# in /var/lib/docker/containers, but without any capability: it only reads
# the cgroups and those files, writes nothing but its folder, never talks to
# Docker and needs no network.
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Only pseudo devices such as /dev/null: no disks, input or other hardware.
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Without capabilities the clock cannot be set anyway; this also blocks the
# calls that set it, as in the other add-ons' units.
SystemCallFilter=~@clock
ProtectHostname=yes
# No socket of any kind: as root it could otherwise connect to the Unix
# sockets of services such as Docker or systemd and have them act for it.
RestrictAddressFamilies=none
# The call that opens a socket is denied as well, so this does not rest on
# how systemd reads "none": before 249 (as on Raspberry Pi OS bullseye) it
# warns that it does not know the word, though it still allows no family.
SystemCallFilter=~socket
# A denied call fails instead of ending the program.
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=den-watcher.service
