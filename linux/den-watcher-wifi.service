# The Wi-Fi add-on of den-watcher: reads the link quality and signal of
# each connected wireless interface, and the Wi-Fi networks nearby, and
# writes them to /run/den-watcher-addons, which den-watcher shows.
# install.sh puts it in /etc/systemd/system when the add-on is picked.
[Unit]
Description=Den-Watcher Wi-Fi add-on: reads the link quality and signal of each connected Wi-Fi interface and the Wi-Fi networks nearby; runs as a user without privileges
Documentation=https://github.com/Programmer-Den/den-watcher
PartOf=den-watcher.service
After=den-watcher.service NetworkManager.service

[Service]
ExecStart=/usr/local/bin/den-watcher-wifi
# It asks NetworkManager over the system D-Bus for the networks nearby,
# where root could have systemd and other services act for it, so like the
# Bluetooth add-on it runs as a throwaway user. That user may not write to
# the root-owned add-on folder, so it writes to a folder of its own in it,
# and a link in the add-on folder, made and removed by systemd as root
# ("+"), points den-watcher at its report.
DynamicUser=yes
Environment=ADDONS_DIR=/run/den-watcher-addons/wifi
RuntimeDirectory=den-watcher-addons/wifi
RuntimeDirectoryMode=0755
ExecStartPre=+/bin/ln -sfn wifi/wifi.json /run/den-watcher-addons/wifi.json
ExecStopPost=+/bin/rm -f /run/den-watcher-addons/wifi.json
Restart=on-failure
RestartSec=5

# It reads the host's network through /proc/1/net, whose wireless file
# anyone may read, so it needs no network of its own, only the Unix socket
# of the system D-Bus, and starts no other program. NetworkManager lets any
# user read its access points, the ones its own scans found; the add-on
# starts no scan, and changing a connection takes an authorization polkit
# does not give a user outside a login session.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Only pseudo devices such as /dev/null: no disks, input or other hardware.
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Without capabilities the clock cannot be set anyway; this also blocks the
# calls that set it, as in the other add-ons' units.
SystemCallFilter=~@clock
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

[Install]
WantedBy=den-watcher.service
