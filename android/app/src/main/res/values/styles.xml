<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <!-- The small label at the top of a card. -->
    <style name="Heading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Button.Filled">
        <item name="android:background">@drawable/button_filled</item>
        <item name="android:textColor">@color/button_filled_text</item>
    </style>

    <style name="Button.Outlined">
        <item name="android:background">@drawable/button_outlined</item>
        <item name="android:textColor">@color/button_outlined_text</item>
    </style>

    <!-- A choice of the map's time range: filled while picked, outlined otherwise, set by MapActivity. -->
    <style name="Button.Range">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/button_outlined</item>
        <item name="android:textColor">@color/button_outlined_text</item>
    </style>

    <!-- A small round button with one sign, to step through the points of the map. -->
    <style name="Button.Step">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@drawable/button_outlined</item>
        <item name="android:textColor">@color/button_outlined_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- A link-like button, flush with the card's text. -->
    <!-- A zoom button over the map: square, 40 dp, its sign in the text's color. -->
    <style name="MapButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/button_text</item>
        <item name="android:tint">@color/on_surface</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Button.Text">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginStart">-12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/button_text</item>
        <item name="android:drawableEnd">@drawable/ic_open</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- A group's switch under Which data do you want to collect, and the switches of its data below it. -->
    <style name="CollectGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CollectItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
