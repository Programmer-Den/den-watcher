<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/mascot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginBottom="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/intro" />

        <LinearLayout
            android:id="@+id/network_group"
            style="@style/Card"
            android:background="@drawable/card_warning">

            <TextView
                style="@style/Heading"
                android:text="@string/network_title"
                android:textColor="@color/on_warning" />

            <TextView
                android:id="@+id/network"
                style="@style/Hint"
                android:textColor="@color/on_warning" />

            <Button
                android:id="@+id/network_usual"
                style="@style/Button.Outlined"
                android:text="@string/network_usual"
                android:textColor="@color/on_warning" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/status_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                style="@style/Hint" />

            <TextView
                android:id="@+id/problem"
                style="@style/Hint"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/toggle"
                style="@style/Button.Filled" />

            <Button
                android:id="@+id/open_hub"
                style="@style/Button.Text"
                android:text="@string/open_hub" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/code_title" />

            <TextView
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="@color/primary"
                android:textIsSelectable="true"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Hint"
                android:text="@string/code_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/address_title" />

            <TextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:textColor="@color/on_surface"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/address_hint"
                style="@style/Hint" />

            <Button
                android:id="@+id/scan"
                style="@style/Button.Outlined"
                android:text="@string/scan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/battery_group"
            style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/battery_title" />

            <TextView
                style="@style/Hint"
                android:text="@string/battery_hint" />

            <Button
                android:id="@+id/battery"
                style="@style/Button.Outlined"
                android:text="@string/battery" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/nearby_title" />

            <TextView
                android:id="@+id/nearby_state"
                style="@style/Hint" />

            <TextView
                style="@style/Hint"
                android:text="@string/nearby_hint" />

            <Button
                android:id="@+id/nearby"
                style="@style/Button.Outlined" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/tracking_title" />

            <TextView
                android:id="@+id/tracking_hint"
                style="@style/Hint"
                android:text="@string/tracking_hint" />

            <Switch
                android:id="@+id/track_system"
                style="@style/TrackGroup"
                android:text="@string/track_system" />

            <Switch
                android:id="@+id/track_battery"
                style="@style/TrackItem"
                android:text="@string/track_battery" />

            <Switch
                android:id="@+id/track_memory"
                style="@style/TrackItem"
                android:text="@string/track_memory" />

            <Switch
                android:id="@+id/track_storage"
                style="@style/TrackItem"
                android:text="@string/track_storage" />

            <Switch
                android:id="@+id/track_network"
                style="@style/TrackGroup"
                android:text="@string/track_network" />

            <Switch
                android:id="@+id/track_traffic"
                style="@style/TrackItem"
                android:text="@string/track_traffic" />

            <Switch
                android:id="@+id/track_nearby"
                style="@style/TrackItem"
                android:text="@string/track_nearby" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Heading"
                android:text="@string/data_title" />

            <TextView
                style="@style/Hint"
                android:text="@string/data_hint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
