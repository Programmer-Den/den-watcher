<?xml version="1.0" encoding="utf-8"?>
<!-- The hub app's hub, at the top of the main screen (see Flavor). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hub_card"
    style="@style/Card">

    <TextView
        style="@style/Heading"
        android:text="@string/hub_title" />

    <TextView
        android:id="@+id/hub_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_surface"
        android:textIsSelectable="true"
        android:textSize="18sp" />

    <!-- The page's address as a code, black on white so a camera reads it in dark mode too. -->
    <ImageView
        android:id="@+id/hub_code"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:contentDescription="@string/hub_code_description"
        android:padding="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hub_code_hint"
        style="@style/Hint"
        android:text="@string/hub_code_hint"
        android:visibility="gone" />

    <Switch
        android:id="@+id/hub_run"
        style="@style/CollectGroup"
        android:text="@string/hub_run" />

    <Button
        android:id="@+id/hub_open"
        style="@style/Button.Filled"
        android:text="@string/hub_open" />

    <TextView
        style="@style/Hint"
        android:layout_marginTop="12dp"
        android:text="@string/hub_tips" />

    <TextView
        android:id="@+id/hub_own_phone"
        style="@style/Hint"
        android:text="@string/hub_own_phone" />

    <!-- Whether root adds the processor and temperatures (see Root), once known. -->
    <TextView
        android:id="@+id/hub_root"
        style="@style/Hint"
        android:visibility="gone" />
</LinearLayout>
